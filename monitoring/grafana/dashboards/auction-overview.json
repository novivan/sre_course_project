        {"editorMode": "code", "expr": "100 * (sum(rate(http_server_requests_seconds_count{service=\"auction-api\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(http_server_requests_seconds_count{service=\"auction-api\"}[$__rate_interval])), 0.001)", "legendFormat": "5xx rate", "range": true, "refId": "A"}
